{
  "name": "@implicit-invocation/three-ui",
  "version": "0.2.0",
  "description": "Retained-mode 2D UI on three-2d with Yoga flexbox layout. No React, no DOM required.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "three",
    "ui",
    "yoga",
    "flexbox",
    "webgpu",
    "react-native"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun ../../scripts/copy-files.ts 'src/yoga/generated/*.d.ts' dist/yoga/generated",
    "dev": "bun run build && vite build --watch --emptyOutDir=false",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@implicit-invocation/three-2d": "workspace:^"
  },
  "peerDependencies": {
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "binaryen": "^132.0.0",
    "three": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "yoga-layout": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
