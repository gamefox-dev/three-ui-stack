{
  "name": "three-2d-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "three": "^0.186.1",
      "@types/three": "^0.186.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react-reconciler": "~0.34.0",
      "@types/react-reconciler": "~0.33.1",
      "@vitejs/plugin-react": "^6.1.2",
      "yoga-layout": "3.2.1",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/node": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@tailwindcss/oxide": "^4.3.3",
      "opentype.js": "^2.0.0",
      "vite": "^8.3.2",
      "vitest": "^5.0.3",
      "typescript": "^7.0.2",
      "@types/node": "^24.0.0",
      "@changesets/cli": "^3.0.3"
    }
  },
  "scripts": {
    "dev": "bun run build:packages && bun run --parallel --filter './examples/*' dev",
    "dev:packages": "bun run --parallel --filter './packages/*' dev",
    "build": "bun run build:packages && bun run --filter './examples/*' build",
    "build:packages": "bun run --filter './packages/*' build",
    "build:pages": "bun scripts/build-pages.ts",
    "typecheck": "bun run --filter './packages/*' --filter './examples/*' --if-present typecheck && tsc -p tsconfig.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "bun run --filter './packages/*' --filter './examples/*' --if-present lint",
    "check": "bun run build:packages && bun run typecheck && bun run test && bun run check:exports && bun run check:boundaries",
    "check:exports": "bun scripts/check-package-exports.ts",
    "check:boundaries": "bun scripts/check-package-boundaries.ts",
    "pack:smoke": "bun scripts/pack-smoke-test.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run check && bun run pack:smoke && bun scripts/publish-packages.ts",
    "release:next": "bun run check && bun run pack:smoke && bun scripts/publish-packages.ts --tag next",
    "build:yoga-asm": "bun scripts/build-yoga-asm.ts",
    "build:fonts": "bun scripts/build-example-fonts.ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@implicit-invocation/three-2d-font": "workspace:^"
  }
}
