{
  "name": "@implicit-invocation/three-2d-font",
  "version": "0.6.0",
  "description": "TTF/OTF to bitmap-font atlas tooling for three-2d: portable parser, rasterizers, atlas packer and CLI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "three",
    "font",
    "bitmap-font",
    "atlas",
    "opentype",
    "ttf"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "three-2d-font": "./bin/three-2d-font.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "bun run build && vite build --watch --emptyOutDir=false",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "opentype.js": "catalog:",
    "@implicit-invocation/three-2d": "workspace:^"
  },
  "peerDependencies": {
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "three": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
